  "dependencies": {
    "@quattestor/core": "workspace:*",
    "@quattestor/adapters": "workspace:*",
    "@anastasia-labs/cardano-multiplatform-lib-nodejs": "6.2.0-1",
    "@lucid-evolution/lucid": "^0.6.7",
    "@noble/curves": "^2.4.0",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^4.0.1",
    "ethers": "^6.13.4"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0"
  }
}

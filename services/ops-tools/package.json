{
  "name": "@quattestor/ops-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-deployment": "tsc -p tsconfig.json && node --env-file=../../.env dist/checkDeployment.js",
    "gas-proof": "tsc -p tsconfig.json && node --env-file=../../.env dist/gasProof.js",
    "attestation-logs": "tsc -p tsconfig.json && node --env-file=../../.env dist/attestationLogs.js",
    "real-gas-numbers": "tsc -p tsconfig.json && node --env-file=../../.env dist/realGasNumbers.js",
    "cardano-bootstrap-vault": "tsc -p tsconfig.json && node --env-file=../../.env dist/cardanoBootstrapVault.js",
    "cardano-generate-wallet": "tsc -p tsconfig.json && node --env-file=../../.env dist/cardanoGenerateWallet.js",
    "cardano-derive-address": "tsc -p tsconfig.json && node --env-file=../../.env dist/cardanoDeriveAddress.js",
    "cardano-e2e": "tsc -p tsconfig.json && node --env-file=../../.env dist/cardanoE2E.js",
    "solana-e2e": "tsc -p tsconfig.json && node --env-file=../../.env dist/solanaE2E.js",
    "first-exposure-finder": "tsc -p tsconfig.json && node --env-file=../../.env dist/firstExposureFinder.js"

# NOWNodes
NOWNODES_API_KEY=

# Ethereum Sepolia (baseline, always required)
ETH_RPC_URL=https://eth-sepolia.nownodes.io
# UNVERIFIED -- exact WSS path/query format not confirmed from public docs
# (JS-rendered page, couldn't be scraped). Check NOWNodes dashboard after
# generating an API key, or ask in their Discord. Not required for the
# baseline smoke test (HTTP POST /attest works without it) -- only needed
# for the real-time trigger demo bonus.
ETH_WSS_URL=wss://eth-sepolia.nownodes.io/wss/<your-api-key>
CHAIN_ID=11155111

# Deployed contract addresses (filled in after `forge script script/Deploy.s.sol --broadcast`)
VAULT_ADDRESS=
VERIFIER_ADDRESS=

# Keys -- demo/test wallets ONLY, never the user's main wallet
DEPLOYER_PRIVATE_KEY=
TRUSTED_OPERATOR_ADDRESS=
OPERATOR_PRIVATE_KEY=
USER_PRIVATE_KEY=

# signer-script -> verifier-service
VERIFIER_SERVICE_URL=http://localhost:8787
AMOUNT_WEI=1000000000000000
PORT=8787

# --- Base Sepolia -- CONFIRMED by NOWNodes support directly (6 Okt 2026):
# testnet enabled specifically for hackathon keys, not publicly documented
# (hence why plain HTTP probing earlier found mainnet only). chainId = 84532.
# Same Vault.sol/Verifier.sol bytecode as Sepolia -- deploy with
# `forge script script/Deploy.s.sol --rpc-url $BASE_RPC_URL --broadcast`,
# this is a SEPARATE deployment with its own VAULT/VERIFIER address.
BASE_RPC_URL=https://base-sepolia.nownodes.io
BASE_CHAIN_ID=84532
BASE_VAULT_ADDRESS=
BASE_VERIFIER_ADDRESS=

# Arbitrum: cancelled (user decision, 6 Okt 2026) -- not in scope anymore.

# --- Solana -- CONFIRMED mainnet-only by NOWNodes support directly:
# "we can't enable Solana devnet for hackathon keys". A testnet subdomain
# exists at DNS level (sol-testnet.nownodes.io, HTTP 422) but is NOT
# accessible with a hackathon key -- host existing doesn't mean the key can
# use it. Use mainnet, confirmed to support getTransaction,
# getSignaturesForAddress, getMultipleAccounts with a hackathon key.
SOLANA_RPC_URL=https://sol.nownodes.io
SOLANA_PROGRAM_ID=
SOLANA_DEPLOYER_SECRET_KEY=
SOLANA_OPERATOR_SECRET_KEY=
SOLANA_USER_SECRET_KEY=

# Osmosis: removed (user decision, 6 Okt 2026), replaced by Cardano below.

# --- Cardano -- CONFIRMED mainnet-only by NOWNodes support directly:
# Blockfrost-compatible REST endpoint, address/UTXO/transaction lookups
# confirmed working. UNVERIFIED: the adapter uses Lucid Evolution's native
# Blockfrost provider, which sends header `project_id: <key>` (standard
# Blockfrost auth) -- NOT NOWNodes' usual `api-key` header used by every
# other chain in this repo. "Blockfrost-compatible" strongly implies this
# is correct (the whole point is drop-in compatibility with existing
# Blockfrost client code), but has not been confirmed with a live call.
CARDANO_RPC_URL=https://ada-blockfrost.nownodes.io
CARDANO_NETWORK=Mainnet
# hex VerificationKeyHash -- compiled into the minting policy at build time,
# NOT the same format as TRUSTED_OPERATOR_ADDRESS above (that one is a
# 20-byte EVM address; this is a 28-byte Cardano key hash).
CARDANO_TRUSTED_OPERATOR_PKH=
# Path to contracts/cardano/plutus.json (produced by `aiken build`).
CARDANO_PLUTUS_BLUEPRINT_PATH=./contracts/cardano/plutus.json
# bech32 `ed25519_sk...` private keys.
CARDANO_OPERATOR_SKEY=
CARDANO_USER_SKEY=

# NOTE: no CARDANO_DEPLOYER_SKEY / deploy step -- Plutus validators don't
# get "deployed", their address is derived purely from compiled script +
# parameters. What EVM's Deploy.s.sol / Solana's initialize_vault instruction
# do (bootstrap the first Vault state) has NO equivalent helper written yet
# for Cardano -- someone must manually send ADA to the vault address with an
# inline VaultDatum{owner, counter: 0} to create the first vault UTxO. Flagged
# in PLAN.md as remaining work, not done silently.

# NOWNodes
NOWNODES_API_KEY=

# Ethereum Sepolia (baseline, always required)
ETH_RPC_URL=https://eth-sepolia.nownodes.io
# UNVERIFIED -- exact WSS path/query format not confirmed from public docs
# (JS-rendered page, couldn't be scraped). Check NOWNodes dashboard after
# generating an API key, or ask in their Discord. Not required for the
# baseline smoke test (HTTP POST /attest works without it) -- only needed
# for the real-time trigger demo bonus.
ETH_WSS_URL=wss://eth-sepolia.nownodes.io/wss/<your-api-key>
CHAIN_ID=11155111

# Base mainnet (phase 2 -- real funds, see PLAN.md checklist before use)
# chainId = 8453
BASE_RPC_URL=https://base.nownodes.io

# Arbitrum mainnet (phase 2 -- real funds, see PLAN.md checklist before use)
# chainId = 42161
ARBITRUM_RPC_URL=https://arbitrum.nownodes.io

# Deployed contract addresses (filled in after `forge script script/Deploy.s.sol --broadcast`)
VAULT_ADDRESS=
VERIFIER_ADDRESS=

# Keys -- demo/test wallets ONLY, never the user's main wallet
DEPLOYER_PRIVATE_KEY=
TRUSTED_OPERATOR_ADDRESS=
OPERATOR_PRIVATE_KEY=
USER_PRIVATE_KEY=

# signer-script -> verifier-service
VERIFIER_SERVICE_URL=http://localhost:8787
AMOUNT_WEI=1000000000000000
PORT=8787

# --- Solana (phase 3) -- confirmed via direct HTTP probe (422 = host exists,
# needs api-key -- same signal used to confirm every other chain in this repo):
#   sol.nownodes.io          mainnet -- EXISTS
#   sol-testnet.nownodes.io  testnet -- EXISTS
#   devnet (10+ naming patterns tried)  -- NOT FOUND, likely unsupported
# Architecture doc targets "devnet" -- since it doesn't exist on NOWNodes,
# use testnet below instead (see PLAN.md top note).
SOLANA_RPC_URL=https://sol-testnet.nownodes.io
SOLANA_PROGRAM_ID=
SOLANA_DEPLOYER_SECRET_KEY=
SOLANA_OPERATOR_SECRET_KEY=
SOLANA_USER_SECRET_KEY=

# --- Osmosis (phase 4) -- confirmed via direct HTTP probe + official docs:
#   osmo.nownodes.io          mainnet RPC -- EXISTS
#   osmo-tendermint.nownodes.io  mainnet Tendermint -- EXISTS
#   osmo-grpc.nownodes.io     mainnet gRPC -- EXISTS
#   testnet (15+ naming patterns tried, incl. real chain-id "osmo-test-5")
#     -- NOT FOUND. Same failure category as Base Sepolia (claimed
#     supported, turned out not to exist). Log into the NOWNodes dashboard
#     yourself to confirm before assuming it's unsupported -- see PLAN.md
#     top note. If truly unsupported, Osmosis needs the same mainnet pivot
#     Base/Arbitrum already went through (real funds, safety checklist).
OSMOSIS_RPC_URL=https://osmo.nownodes.io
OSMOSIS_VAULT_CONTRACT_ADDRESS=
OSMOSIS_VERIFIER_CONTRACT_ADDRESS=
OSMOSIS_OPERATOR_SECRET_KEY=
OSMOSIS_USER_SECRET_KEY=

# NOWNodes
NOWNODES_API_KEY=

# Ethereum Sepolia (baseline, always required)
ETH_RPC_URL=https://eth-sepolia.nownodes.io
# UNVERIFIED -- exact WSS path/query format not confirmed from public docs
# (JS-rendered page, couldn't be scraped). Check NOWNodes dashboard after
# generating an API key, or ask in their Discord. Not required for the
# baseline smoke test (HTTP POST /attest works without it) -- only needed
# for the real-time trigger demo bonus.
ETH_WSS_URL=wss://eth-sepolia.nownodes.io/wss/<your-api-key>
CHAIN_ID=11155111

# Base mainnet (phase 2 -- real funds, see PLAN.md checklist before use)
# chainId = 8453
BASE_RPC_URL=https://base.nownodes.io

# Arbitrum mainnet (phase 2 -- real funds, see PLAN.md checklist before use)
# chainId = 42161
ARBITRUM_RPC_URL=https://arbitrum.nownodes.io

# Deployed contract addresses (filled in after `forge script script/Deploy.s.sol --broadcast`)
VAULT_ADDRESS=
VERIFIER_ADDRESS=

# Keys -- demo/test wallets ONLY, never the user's main wallet
DEPLOYER_PRIVATE_KEY=
TRUSTED_OPERATOR_ADDRESS=
OPERATOR_PRIVATE_KEY=
USER_PRIVATE_KEY=

# signer-script -> verifier-service
VERIFIER_SERVICE_URL=http://localhost:8787
AMOUNT_WEI=1000000000000000
PORT=8787
